rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──
    // Each user can only read/write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-collections: pdfs, flashcards, jobs, roadmaps
      match /pdfs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /flashcards/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /jobs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /roadmaps/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── JEE questions (public read, no writes from client) ──
    match /jee_questions/{docId} {
      allow read: if true;
      allow write: if false; // only writable via Admin SDK / Firebase console
    }

    match /jee_questions/{docId}/{rest=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Default: deny all ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
