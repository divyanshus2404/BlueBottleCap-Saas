rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──
    // Users can read their own doc freely, but writes are restricted:
    // billing/entitlement fields (activePlan, creditsRemaining, purchases,
    // etc.) can ONLY be written by the server via Admin SDK. The client can
    // update everyday progress fields (streak, study log, avatar, etc.).
    //
    // Without this split, any signed-in user could self-upgrade to Pro from
    // the browser console by calling updateDoc({ activePlan: "Pro" }).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !hasEntitlementFields(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !changesEntitlementFields();

      allow delete: if false;

      // Sub-collections stay open for the owning user — no billing state here.
      match /pdfs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /flashcards/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /jobs/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /roadmaps/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── JEE questions (public read, no writes from client) ──
    match /jee_questions/{docId} {
      allow read: if true;
      allow write: if false; // only writable via Admin SDK / Firebase console
    }
    match /jee_questions/{docId}/{rest=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── OTP codes — server-only. ──
    // Never readable/writable by clients. The OTP flow uses Admin SDK.
    match /otpCodes/{docId} {
      allow read, write: if false;
    }

    // ── JEE content (public read, Admin-only write) ──
    // Read by the client via useFirebaseJEE (getDocs). Content is authored
    // server-side / in the console, never by clients.
    match /jee_mock_tests/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /jee_subjects/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Analytics events (append-only from the client) ──
    // analytics.ts addDoc()s here; the abandoned-checkout cron reads them via
    // Admin SDK. Clients may only CREATE, and may not read back, edit, or
    // delete — so one user can't mine another's activity, and events are
    // tamper-proof once written. A signed-in uid is required so the firehose
    // isn't open to anonymous spam.
    match /events/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── Mock test results (owner-scoped) ──
    // VirtualTestMode addDoc()s a result tagged with the user's uid. Readable
    // and writable only by that owner; no entitlement state lives here, so no
    // field restriction is needed — but the doc MUST carry the writer's own
    // uid so it can't be filed under someone else.
    match /test_results/{docId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Default: deny all ──
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // ── Helpers ──
  // Fields that must only be set/modified by the server (Razorpay verify
  // route, OTP verify route). Admin SDK bypasses rules entirely, so the
  // server can still write these; clients cannot.
  function entitlementFields() {
    return [
      "activePlan", "plan", "creditsRemaining", "creditsLeft",
      "purchasedTests", "purchasedMaterial", "studyMaterialUnlocked",
      "lastPaymentId", "lastOrderId", "streakSaved", "lastStreakSaveAt",
      "emailVerified", "role",
      "dailyCredits", "creditRefillDay", "purchasedCredits"
    ];
  }

  function hasEntitlementFields(data) {
    return data.keys().hasAny(entitlementFields());
  }

  function changesEntitlementFields() {
    // Which fields are being added/changed in this update?
    let writing = request.resource.data.diff(resource.data).affectedKeys();
    return writing.hasAny(entitlementFields());
  }
}
