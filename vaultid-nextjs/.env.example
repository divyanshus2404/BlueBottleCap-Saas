# Resend API Key for sending Email OTPs
RESEND_API_KEY=re_123456789

# Twilio Credentials for sending SMS OTPs
TWILIO_ACCOUNT_SID=AC123456789
TWILIO_AUTH_TOKEN=123456789
TWILIO_PHONE_NUMBER=+1234567890

# Secret used to sign HMAC-SHA256 session cookies (Generate with: openssl rand -base64 32)
OTP_SECRET=your_super_secret_otp_signing_key_here

# Base URL for your Next.js application
NEXT_PUBLIC_APP_URL=http://localhost:3000
