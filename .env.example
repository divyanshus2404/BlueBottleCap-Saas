# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay — both are SERVER-SIDE secrets. Never expose the secret to the client.
# Use live keys (rzp_live_...) in production; test keys won't accept real payments.
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"

# Feedback email — used by /api/feedback to deliver in-app feedback to your inbox.
# For Gmail: enable 2FA, then generate an App Password
# (myaccount.google.com → Security → App passwords) and paste it as SMTP_PASS.
# If these aren't set, feedback is logged to the server console instead of emailed.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="your_app_password"
FEEDBACK_TO="you@gmail.com"

# Firebase (client) — powers auth, Firestore user data, streaks, purchases.
# These are NEXT_PUBLIC_ (safe to expose; Firestore security rules protect data).
# Get them from Firebase console → Project settings → General → Your apps → Web app.
# Without these, auth and all cloud persistence silently no-op.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxx"

# Firebase Admin (server) — the FULL service-account JSON on a single line.
# Enables server-side purchase persistence + entitlement granting in
# /api/razorpay/verify. Firebase console → Project settings → Service accounts
# → Generate new private key. NEVER commit the real value — it's full access.
# If unset, the app degrades to client-side-only entitlements (no crash).
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# CRON_SECRET — protects the scheduled email routes (/api/cron/*). Vercel Cron
# automatically sends this as a Bearer token when the env var is set. Also
# signs one-click email unsubscribe links. Generate any long random string:
#   openssl rand -hex 32
# Without it, the cron routes refuse to run (401) rather than run unprotected.
CRON_SECRET="a_long_random_secret"
